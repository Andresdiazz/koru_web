# Copia este archivo como .env.local y completa los valores.

# Resend (envío de correos del formulario KORU Business)
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. "KORU <reservas@tudominio.com>"
RESEND_FROM=

# URL pública del sitio (sin barra final). En Vercel puedes dejarla vacía hasta tener dominio.
NEXT_PUBLIC_SITE_URL=

# Analítica (si están vacías, no se carga nada)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
