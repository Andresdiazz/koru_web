# Copia este archivo como .env.local y completa los valores.

# Resend (envío de correos del formulario KORU Business)
RESEND_API_KEY=
# Remitente verificado en Resend (dominio koruclub.co)
# RESEND_FROM="KORU <reservas@koruclub.co>"
RESEND_FROM=

# URL pública del sitio (sin barra final), p. ej. https://koruclub.co
NEXT_PUBLIC_SITE_URL=

# Analítica (si están vacías, no se carga nada)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
